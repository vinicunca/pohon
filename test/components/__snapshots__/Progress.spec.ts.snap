// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`progress > renders with animation carousel correctly 1`] = `
"<div data-orientation="horizontal" data-slot="root" class="">
  <!--v-if-->
  <div aria-valuemax="100" aria-valuemin="0" role="progressbar" data-state="indeterminate" data-max="100" data-slot="base" style="transform: translateZ(0);">
    <div data-state="indeterminate" data-max="100" data-slot="indicator" class=""></div>
  </div>
  <!--v-if-->
</div>"
`;

