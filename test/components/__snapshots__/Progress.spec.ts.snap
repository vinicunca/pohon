exports[`progress > renders with color neutral correctly 1`] = `
"<div data-orientation="horizontal" data-slot="root" class="">
  <!--v-if-->
  <div aria-valuemax="100" aria-valuemin="0" aria-valuenow="50" aria-label="50%" role="progressbar" data-state="loading" data-value="50" data-max="100" data-slot="base" style="transform: translateZ(0);">
    <div data-state="loading" data-value="50" data-max="100" data-slot="indicator" class="" style="transform: translateX(-50%);"></div>
  </div>
  <!--v-if-->
</div>"
`;

exports[`progress > renders with max correctly 1`] = `
"<div data-orientation="horizontal" data-slot="root" class="">
  <div data-slot="status" class="" style="width: 50%;">50% </div>
  <div aria-valuemax="4" aria-valuemin="0" aria-valuenow="2" aria-label="50%" role="progressbar" data-state="loading" data-value="2" data-max="4" data-slot="base" style="transform: translateZ(0);">
    <div data-state="loading" data-value="2" data-max="4" data-slot="indicator" class="" style="transform: translateX(-50%);"></div>
  </div>
  <div data-slot="steps" class="">
    <div data-slot="step" class="">Waiting...</div>
    <div data-slot="step" class="">Cloning...</div>
    <div data-slot="step" class="">Migrating...</div>
    <div data-slot="step" class="">Deploying...</div>
    <div data-slot="step" class="">Done!</div>
  </div>
</div>"
`;

