      <div data-slot="content" class="relative overflow-hidden flex flex-col" role="listbox" tabindex="-1" aria-orientation="vertical" aria-multiselectable="false" data-orientation="vertical">
        <div role="presentation" data-slot="viewport" class="relative scroll-py-1 overflow-y-auto flex-1 focus:outline-none divide-y divide-divide">
          <div role="group" aria-labelledby="akar-listbox-group-v-0-0-0" data-slot="group" class="p-1 isolate">
            <div id="akar-listbox-group-v-0-0-0" data-slot="label" class="font-600 color-text-highlighted p-1.5 text-xs gap-1.5">Go to</div><a href="/" role="option" tabindex="-1" data-akar-collection-item="" id="akar-listbox-item-v-0-0-1" aria-selected="false" data-state="unchecked" data-slot="item" class="group outline-none flex w-full select-none items-start relative before:rounded-md before:content-empty before:inset-px before:absolute before:-z-1 data-[disabled]:opacity-75 data-[disabled]:cursor-not-allowed p-1.5 text-sm gap-1.5 color-text-highlighted before:bg-background-elevated" data-highlighted="">
